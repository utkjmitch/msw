{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "out_dir": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "live",
            "test"
          ]
        },
        "test_copy": {
          "default": false,
          "type": "boolean"
        },
        "seeded_data": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "test_copy",
        "seeded_data"
      ],
      "additionalProperties": false
    },
    "allowed_for_transact": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "payment_test_mode": {
      "default": false,
      "type": "boolean"
    },
    "mask_personal_data": {
      "default": true,
      "type": "boolean"
    },
    "mask_names_file": {
      "type": "string"
    },
    "mask_selectors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "admin_read_only": {
      "type": "object",
      "properties": {
        "authorized_by": {
          "type": "string",
          "minLength": 1
        },
        "authorized_on": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "authorized_by",
        "authorized_on",
        "quote"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "out_dir",
    "environment",
    "allowed_for_transact",
    "payment_test_mode",
    "mask_personal_data",
    "mask_selectors"
  ],
  "additionalProperties": false
}
